#!/bin/sh
# Standalone Ports Script Template

# main configuration :
GameName="Kuula"
GameDir="Kuula"
GameExecutable="launch.sh"
GameDataFile="launch.sh"

# additional configuration
# MI_AO, the audio device, has one owner: stop Onion's audio server.
KillAudioserver=1
# The CPU governor is ondemand; a 60 Hz cart wants it fixed high.
PerformanceMode=1

# specific to this port :
Arguments=""

# running command line :
/mnt/SDCARD/Emu/PORTS/launch_standalone.sh "$GameName" "$GameDir" "$GameExecutable" "$Arguments" "$GameDataFile" "$KillAudioserver" "$PerformanceMode"
